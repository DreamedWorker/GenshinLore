{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./docs/.vitepress/theme/*"]
    },
    "types": ["vite/client"]
  },
  "include": ["./**/*.mts", "./**/*.ts", "./**/*.d.ts"],
  "exclude": ["dist", "cache"]
}
